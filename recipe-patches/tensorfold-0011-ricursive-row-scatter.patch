@@ -0,0 +1,52 @@
+//! Prompt rows' o_proj and down_proj partials at three ranks or more: a reduce-scatter by rows in rank order (each rank
+//! adds its share of the rows from every rank, tf_rank_sum: the same adds in the same order as tf_ripple_rank_sum), then
+//! each rank sends its summed rows to every other. A rank receives half the bytes of gathering every whole partial, and
+//! the sums keep their bits. TF_RICURSIVE_SCATTER=0 keeps the gather.
+const std = @import("std");
+const cuda = @import("cuda");
+
+const share = cuda.rank_scatter.share;
+
+pub const Scatter = struct {
+    rs: cuda.rank_scatter.RankScatter,
+    scratch: cuda.DeviceBuffer,
+
+    /// Up to `rows` rows of `width` fp32 values a call, at `world` ranks.
+    pub fn init(d: *const cuda.Driver, rows: usize, world: usize, width: usize) !Scatter {
+        var rs = try cuda.rank_scatter.RankScatter.load(d);
+        errdefer rs.unload();
+        return .{ .rs = rs, .scratch = try cuda.DeviceBuffer.alloc(d, cuda.rank_scatter.scratchBytes(rows, world, width)) };
+    }
+
+    pub fn deinit(x: *Scatter) void {
+        x.scratch.free();
+        x.rs.unload();
+    }
+
+    /// Every rank's `partial` [rows][width] fp32 summed in rank order into `into` [rows][width], on `s`.
+    pub fn sum(x: *const Scatter, g: *const cuda.tp_group.Group, s: cuda.Stream, partial: u64, rows: usize, width: usize, into: u64) !void {
+        const mine = share(rows, g.world, g.rank);
+        try x.rs.run(&g.lib, g.comm, g.world, g.rank, s, partial, rows, width, x.scratch.ptr, into + mine[0] * width * 4);
+        try g.lib.group(Spread{ .g = g, .s = s, .into = into, .rows = rows, .width = width }, Spread.post);
+    }
+
+    /// The summed shares to every rank: one send/recv group, each share straight into its rows of `into`.
+    const Spread = struct {
+        g: *const cuda.tp_group.Group,
+        s: cuda.Stream,
+        into: u64,
+        rows: usize,
+        width: usize,
+
+        fn post(t: Spread) anyerror!void {
+            const mine = share(t.rows, t.g.world, t.g.rank);
+            const row = t.width * 4;
+            for (0..t.g.world) |peer| {
+                if (peer == t.g.rank) continue;
+                const theirs = share(t.rows, t.g.world, peer);
+                if (mine[1] > mine[0]) try t.g.send(t.s, t.into + mine[0] * row, (mine[1] - mine[0]) * row, peer);
+                if (theirs[1] > theirs[0]) try t.g.recv(t.s, t.into + theirs[0] * row, (theirs[1] - theirs[0]) * row, peer);
+            }
+        }
+    };
+};
