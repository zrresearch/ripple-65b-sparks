diff --git a/zig/src/families/ricursive/cuda_overlap.zig b/zig/src/families/ricursive/cuda_overlap.zig
new file mode 100644
index 000000000..b00f9f8ed
--- /dev/null
+++ b/zig/src/families/ricursive/cuda_overlap.zig
@@ -0,0 +1,75 @@
+//! A prompt call's o_proj through post_ffn in two row halves at three ranks or more: each half's row-scatter sum
+//! (cuda_scatter.zig) runs on a second stream while the other half computes. The sum of o_proj's first half overlaps
+//! o_proj's second half, the second half's sum the first half's MLP, and down_proj's first-half sum the second half's
+//! MLP; only down_proj's second-half sum is waited out. Every row runs the same kernels on the same inputs as in one
+//! pass, so the bits do not change. TF_RICURSIVE_OVERLAP=0 runs one pass.
+const std = @import("std");
+const cuda = @import("cuda");
+
+/// Rows a call takes before it splits: halves of at least one pfdense row tile (128 rows) each.
+pub const min_rows = 256;
+
+pub const Overlap = struct {
+    comm: cuda.Stream, // the sums' stream (highest priority, so its kernels take SMs as they free)
+    ready: [4]cuda.Event, // a half's partials written (o_proj 0, 1; down_proj 0, 1)
+    summed: [4]cuda.Event, // that half's sums in `a`
+
+    pub fn init(d: *const cuda.Driver) !Overlap {
+        var o: Overlap = .{ .comm = try cuda.Stream.initPriority(d, .highest), .ready = undefined, .summed = undefined };
+        for (&o.ready, &o.summed) |*r, *s| {
+            r.* = try cuda.Event.init(d, false);
+            s.* = try cuda.Event.init(d, false);
+        }
+        return o;
+    }
+
+    pub fn deinit(o: *Overlap) void {
+        for (&o.ready, &o.summed) |*r, *s| {
+            r.deinit();
+            s.deinit();
+        }
+        o.comm.deinit();
+    }
+
+    /// Model's layer tail for `n` prompt rows of layer `l` (gated rows in b.gated), as cuda_forward's single pass.
+    pub fn run(o: *Overlap, m: anytype, hw: anytype, l: anytype, n: usize) !void {
+        const s = m.stream;
+        const c = m.c;
+        const b = &m.b;
+        const h = c.hidden;
+        const qw = m.hq * @import("config.zig").head_dim;
+        const g = &m.group.?;
+        const x = &m.scatter.?;
+        const mid = std.mem.alignForward(usize, n / 2, 16);
+        const halves = [2][2]usize{ .{ 0, mid }, .{ mid, n } };
+        const mine = b.parts + m.rank() * n * h * 4; // this rank's partials, rows in order
+        const gu_up = b.gu + n * m.ff * 2;
+        for (halves, 0..) |r, i| {
+            try m.proj(hw, l.o, b.gated + r[0] * qw * 2, .f16, r[1] - r[0], mine + r[0] * h * 4, .f32);
+            try o.sumAfter(s, x, g, i, mine + r[0] * h * 4, r[1] - r[0], h, b.a + r[0] * h * 4);
+        }
+        for (halves, 0..) |r, i| {
+            const nh = r[1] - r[0];
+            try s.wait(o.summed[i]);
+            try m.k.normAdd(s, b.a + r[0] * h * 4, l.post_attn, b.x + r[0] * h * 4, nh, h, c.eps);
+            try m.norms.rms(s, b.x + r[0] * h * 4, .f32, l.pre_ffn, b.y + r[0] * h * 2, .f16, nh, h, c.eps);
+            try m.proj(hw, l.gate, b.y + r[0] * h * 2, .f16, nh, b.gu + r[0] * m.ff * 2, .f16);
+            try m.proj(hw, l.up, b.y + r[0] * h * 2, .f16, nh, gu_up + r[0] * m.ff * 2, .f16);
+            try m.k.swiglu(s, b.gu + r[0] * m.ff * 2, gu_up + r[0] * m.ff * 2, b.act + r[0] * m.ff * 2, nh * m.ff, c.clamp);
+            try m.proj(hw, l.down, b.act + r[0] * m.ff * 2, .f16, nh, mine + r[0] * h * 4, .f32);
+            try o.sumAfter(s, x, g, 2 + i, mine + r[0] * h * 4, nh, h, b.a + r[0] * h * 4);
+        }
+        for (halves, 0..) |r, i| {
+            try s.wait(o.summed[2 + i]);
+            try m.k.normAdd(s, b.a + r[0] * h * 4, l.post_ffn, b.x + r[0] * h * 4, r[1] - r[0], h, c.eps);
+        }
+    }
+
+    /// Slot `i`: the comm stream waits for what `s` queued so far, then sums `rows` rows into `into` there.
+    fn sumAfter(o: *Overlap, s: cuda.Stream, x: anytype, g: anytype, i: usize, partial: u64, rows: usize, width: usize, into: u64) !void {
+        try o.ready[i].record(s);
+        try o.comm.wait(o.ready[i]);
+        try x.sum(g, o.comm, partial, rows, width, into);
+        try o.summed[i].record(o.comm);
+    }
+};
