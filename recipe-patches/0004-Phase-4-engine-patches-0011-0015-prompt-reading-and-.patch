+@@ -115,7 +116,8 @@ pub const Model = struct {
+     k: Kernels,
+     group: ?cuda.tp_group.Group = null,
+     pfd: ?Pfd = null, // prompt rows' projections by pfdense (cuda_pfd.zig); null: the trellis kernel
+-    scatter: ?Scatter = null, // three ranks or more: prompt rows' partials by the row scatter (cuda_scatter.zig)
++    scatter: ?Scatter = null,
