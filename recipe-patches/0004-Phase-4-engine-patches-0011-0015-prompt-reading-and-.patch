+diff --git a/zig/src/families/ricursive/cuda_pfd.zig b/zig/src/families/ricursive/cuda_pfd.zig
+new file mode 100644
+index 000000000..c3c4207e2
+--- /dev/null
++++ b/zig/src/families/ricursive/cuda_pfd.zig
+@@ -0,0 +1,90 @@
++//! Prompt rows' projections by pfdense (exl3_block/pfdense.cuh, DeepSeek-V4.1's fused prefill GEMM): exl3's own rot_in,
++//! then a tensor-core GEMM that decodes the trellis inside it, with the output Hadamard and svh in its epilogue. On a
++//! GB10 at a four-rank cut it runs Ripple's projections at 39 TFLOPS at 128 rows and 61-68 from 512 (the trellis
++//! kernel: 30), but not in the trellis kernel's order, so prompt rows no longer give decode rows' bits.
++//! TF_RICURSIVE_PFD=0 keeps the trellis kernel for prompts.
++const std = @import("std");
++const cuda = @import("cuda");
++
++/// pfdense_args.h (BM, WM, WN, KS, NST) of the two configurations ricursive_pfd.cu builds (ids 0 and 5 there).
++const cfgs = [_][5]u32{ .{ 128, 2, 4, 2, 3 }, .{ 128, 2, 4, 2, 2 } };
++const use = 1; // id 5: the fastest at 128, 512 and 2048 rows of Ripple's shapes, level with id 0 at 1024 and 4096
++const k2 = 10;
++
++/// dsv41_pfd::Args.
++const Args = extern struct {
++    xh: u64,
++    T: u64,
++    stride_k: i64,
++    stride_nb: i64,
++    svh: u64,
++    bias: u64 = 0,
++    out: u64,
++    o_stride: i64,
++    M: c_int,
++    K: c_int,
++    N: c_int,
++    group: c_int = 8,
++    out_type: c_int,
++};
++
++comptime {
++    std.debug.assert(@offsetOf(Args, "M") == 64 and @sizeOf(Args) == 88);
++}
++
++/// Lay<K2, LANES, Cfg>::SMEM.
++fn smem(c: [5]u32) u32 {
++    const bm, const wm, _, const ks, const nst = c;
++    const a_bytes = bm * (16 * ks) * 2;
++    const w_bytes = ks * 8 * (4 * k2) * 4;
++    const main = nst * (a_bytes + w_bytes) + 2 * (ks * 8 * 32 * 16);
++    return @max(main, (bm / wm) * 128 * 2 * 2);
++}
++
++fn symbol(comptime c: [5]u32) [:0]const u8 {
++    return std.fmt.comptimePrint("_ZN9dsv41_pfd10pfd_kernelILi{d}ELb0ENS_3CfgILi{d}ELi{d}ELi{d}ELi{d}ELi{d}EEEEEvNS_4ArgsE", .{ k2, c[0], c[1], c[2], c[3], c[4] });
++}
++
++pub const Pfd = struct {
++    mod: cuda.Module,
++    gemm: cuda.Function,
++    xh: cuda.DeviceBuffer, // the rotated fp16 inputs, `rows` rows of the widest K
++
++    pub fn load(d: *const cuda.Driver, rows: usize, k_max: usize) !Pfd {
++        if (!cuda.kernels.available) return error.BuiltWithoutKernels;
++        var mod = try cuda.Module.load(d, cuda.kernels.ricursive_pfd);
++        errdefer mod.unload();
++        const f = try mod.function(symbol(cfgs[use]));
++        try f.allowDynamicShared(smem(cfgs[use]));
++        return .{ .mod = mod, .gemm = f, .xh = try cuda.DeviceBuffer.alloc(d, rows * k_max * 2) };
++    }
++
++    pub fn deinit(p: *Pfd) void {
++        p.xh.free();
++        p.mod.unload();
++    }
++
++    /// Whether pfdense takes `w`: 5.0 bpw mul1 trellis words in the stored layout, no bias.
++    pub fn takes(w: cuda.exl3.Weight) bool {
++        const st = cuda.exl3.strides(w.k, w.n, w.halves, false);
++        return w.halves == k2 and w.codebook == .mul1 and w.bias == 0 and w.stride_k == st.k and w.stride_nb == st.nb and w.k % 128 == 0 and w.n % 128 == 0;
++    }
++
++    /// y [rows, n] (y_dtype) = x [rows, k] (x_dtype) through `w`, on `s`; `rot` is exl3.Linear's tf_exl3_rot_in.
++    pub fn run(p: *const Pfd, s: cuda.Stream, rot: cuda.Function, w: cuda.exl3.Weight, x: u64, x_dtype: cuda.exl3.DType, rows: usize, y: u64, y_dtype: cuda.exl3.DType) !void {
++        var r: cuda.Args = .{};
++        r.add(x);
++        r.add(w.suh);
++        r.add(p.xh.ptr);
++        r.add(@as(i32, @backingInt(x_dtype)));
++        r.add(@as(i32, @intCast(rows)));
++        r.add(@as(i32, @intCast(w.k)));
++        try cuda.launch.launch(rot, .{ .grid = .{ .x = @intCast((w.k / 128 + 3) / 4), .y = @intCast(rows) }, .block = .{ .x = 128 } }, s, &r);
++        const a: Args = .{ .xh = p.xh.ptr, .T = w.trellis, .stride_k = @intCast(w.stride_k), .stride_nb = @intCast(w.stride_nb), .svh = w.svh, .out = y, .o_stride = @intCast(w.n), .M = @intCast(rows), .K = @intCast(w.k), .N = @intCast(w.n), .out_type = @backingInt(y_dtype) };
++        var g: cuda.Args = .{};
++        g.add(a);
++        const bm = cfgs[use][0];
++        const threads = cfgs[use][1] * cfgs[use][2] * 32;
++        try cuda.launch.launch(p.gemm, .{ .grid = .{ .x = @intCast(((rows + bm - 1) / bm) * (w.n / 128)) }, .block = .{ .x = threads }, .shared = smem(cfgs[use]) }, s, &g);
++    }
++};
