+ zig/src/core/lanes/allocate.zig             |   6 +-
+ zig/src/core/lanes/depth.zig                |  13 ++-
+ zig/src/families/ricursive/cuda_draft.zig   | 119 ++++++++++++++++++--
+ zig/src/families/ricursive/cuda_forward.zig |   8 +-
+ zig/src/families/ricursive/cuda_lanes.zig   |   6 +-
+ zig/src/families/ricursive/cuda_native.zig  |   4 +-
+ 6 files changed, 139 insertions(+), 17 deletions(-)
+
+diff --git a/zig/src/core/lanes/allocate.zig b/zig/src/core/lanes/allocate.zig
+index 3fea08998..ec922b99f 100644
+--- a/zig/src/core/lanes/allocate.zig
++++ b/zig/src/core/lanes/allocate.zig
+@@ -2,6 +2,7 @@
+ const std = @import("std");
+ const Allocator = std.mem.Allocator;
+ const Table = @import("table.zig").Table;
++const hold_price = @import("hold_price.zig");
+ 
+ /// A batched head's extra drafts cost the deepest stream's steps; FZ_PRICE_BATCHED=0 prices each stream's.
+ pub fn pricedBatched() bool {
+@@ -22,6 +23,7 @@ pub const HeadCost = struct {
+     batched: bool = false,
+     free_first: bool = false,
+     row_ms: f64 = 0.0, // what each row past a stream's first costs past the table on this machine
++    hold: []const hold_price.HoldCost = &.{}, // a drafter's own pass by the streams it drafts: priced instead of steps
+ };
+ 
+ /// allocate, each stream's drafts past its first costing one more head step.
+@@ -66,7 +68,9 @@ pub fn allocateDrafts(gpa: Allocator, fixed: []const u32, probs: []const []const
+         deepest = @max(deepest, counts[s]);
+         expected += pick_p;
+         const steps: f64 = @floatFromInt(if (head.batched) deepest -| @intFromBool(head.free_first) else drafts - (if (head.free_first) firsts else 0));
+-        const now = rate(costs, timed, rows, expected, overhead_ms + head.step_ms * steps + head.row_ms * @as(f64, @floatFromInt(rows -| live)));
++        // a drafter that timed its pass prices it by the streams drafting and the deepest chain, not by steps
++        const head_ms = if (head.hold.len > 0) hold_price.holdMs(head.hold, @intCast(firsts), deepest) else head.step_ms * steps;
++        const now = rate(costs, timed, rows, expected, overhead_ms + head_ms + head.row_ms * @as(f64, @floatFromInt(rows -| live)));
+         if (now > best or (!timed and head.step_ms == 0)) {
