+    pub const Piece = struct { x: *Ctx, slot: usize, start: u64, rows: usize };
+
+    /// Several streams' verified rows in one plan word and one pass: each stream's taps gathered side by side, then
+    /// fc (one rank sum), the norm and every layer's K and V over all their rows, each stream's into its own rings.
+    fn absorbBatch(d: *Draft, ps: []const Piece) !void {
+        const most = d.c.ringRows() - d.c.block;
+        var h: fwd.Header = .{ .op = @backingInt(fwd.Op.draft_absorbs), .ns = @intCast(ps.len) };
+        for (ps, 0..) |p, i| {
+            const x = p.x;
+            if (p.start < x.end) x.end = p.start;
+            if (p.start > x.end or x.begin > p.start) x.begin = p.start;
+            if (p.start + p.rows > x.begin + most) x.begin = p.start + p.rows - most;
+            h.streams[i] = .{ x.id, @intCast(p.slot), @intCast(p.start), @intCast(p.rows) };
+            h.pos[i] = @intCast(x.begin);
+        }
+        if (d.world > 1) try d.m.plan(&h);
+        try d.absorbMany(ps);
+    }
+
+    /// Every rank: absorbRows for several streams at once (their rows side by side in the pass buffers).
+    pub fn absorbMany(d: *Draft, ps: []const Piece) !void {
+        const c = d.c;
+        const s = d.m.stream;
+        const stride = c.n_taps * c.hidden;
+        const kc = stride / d.world;
+        var total: usize = 0;
+        for (ps) |p| {
