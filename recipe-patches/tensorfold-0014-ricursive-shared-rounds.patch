     /// The modeled time of a shared round's head steps for the depths it drafted.
     pub fn headMs(r: *const Rule, depths: []const i64) f64 {
+        if (r.k.hold_costs.len > 0) { // a timed pass: its streams and deepest chain, as allocateDrafts prices it
+            var streams: usize = 0;
+            var deep: i64 = 0;
+            for (depths) |d| if (d > 0) {
