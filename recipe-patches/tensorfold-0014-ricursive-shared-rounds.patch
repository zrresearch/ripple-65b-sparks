+            total += p.rows;
+        }
+        try d.mmSum(d.b.taps, d.w.fc, d.b.th, total, c.hidden, kc);
+        try d.k.rms(s, d.b.th, d.w.hidden_norm, d.b.thn, c.hidden, c.eps, 0, 0, total);
+        for (d.w.layers[0..c.layers], 0..) |l, i| {
+            try d.mm(d.b.thn, l.k, d.b.ka, total, c.kvWidth(), c.hidden);
+            try d.mm(d.b.thn, l.v, d.b.va, total, c.kvWidth(), c.hidden);
+            var at: usize = 0;
+            for (ps) |p| {
+                const rk = d.ringK(p.x, i);
+                try d.k.kvPut(s, d.b.ka + at * c.kvWidth() * 4, d.b.va + at * c.kvWidth() * 4, l.k_norm, rk, rk + c.ringRows() * c.kvWidth() * 2, c, p.start, c.rope[i], p.rows);
+                at += p.rows;
+            }
         }
+        for (ps) |p| p.x.end = p.start + p.rows;
     }
 
