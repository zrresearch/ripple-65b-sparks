+    fn timeHolds(d: *Draft) !void {
+        const most = @min(fwd.max_streams, d.m.slots);
+        var xs: [fwd.max_streams]*Ctx = undefined;
+        var got: usize = 0;
+        defer for (xs[0..got]) |x| d.pool.append(d.gpa, x) catch d.drop(x);
+        while (got < most) : (got += 1) xs[got] = d.pool.pop() orelse try d.create();
+        var items: [fwd.max_streams]dr.Hold = undefined;
+        d.n_holds = 0;
+        for ([_]usize{ 1, 2, 4, 8, 16 }) |k| {
+            if (k > most) break;
+            for ([_]u32{ 1, @intCast(d.c.block - 1) }) |depth| {
+                for (items[0..k], xs[0..k]) |*it, x| {
